PORT=3001
WEB_URL=http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cv_builder?schema=public"
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=change-me

# Header your host/CDN puts the visitor's country in (e.g. cf-ipcountry),
# for showing prices in their currency. Unset: common ones are tried.
# GEO_COUNTRY_HEADER=

# Daily National Bank of Serbia rates, for showing approximate dinar prices.
# NBS_RATES_URL=https://kurs.resenje.org/api/v1/currencies/{currency}/rates/today

# Signs embedded builder sessions; must differ from JWT_SECRET.
EMBED_JWT_SECRET=change-me-too
