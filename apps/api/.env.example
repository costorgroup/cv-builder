PORT=3001
WEB_URL=http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cv_builder?schema=public"
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=change-me

# Header your host/CDN puts the visitor's country in (e.g. cf-ipcountry),
# for showing prices in their currency. Unset: common ones are tried.
# GEO_COUNTRY_HEADER=

# Daily National Bank of Serbia rates, for showing approximate dinar prices.
# NBS_RATES_URL=https://kurs.resenje.org/api/v1/currencies/{currency}/rates/today

# Signs embedded builder sessions; must differ from JWT_SECRET.
EMBED_JWT_SECRET=change-me-too

# Encrypts customers' storage credentials: 32 random bytes, base64.
# Changing it makes saved credentials unreadable (they must be entered again).
STORAGE_ENCRYPTION_KEY=
# Where uploaded files go in development (platform storage).
STORAGE_DIR=storage

# Where rate limits count requests: "memory" (default, per instance) or
# "database" (shared through Postgres; use with more than one API instance).
RATE_LIMIT_STORE=memory

# Where our own files go: "local" (STORAGE_DIR, one server only) or "s3".
PLATFORM_STORAGE=local
# With PLATFORM_STORAGE=s3: an S3-compatible bucket shared by every instance.
PLATFORM_S3_BUCKET=
PLATFORM_S3_REGION=
# For R2, MinIO and others; leave empty for AWS.
PLATFORM_S3_ENDPOINT=
PLATFORM_S3_PREFIX=
PLATFORM_S3_ACCESS_KEY_ID=
PLATFORM_S3_SECRET_ACCESS_KEY=
